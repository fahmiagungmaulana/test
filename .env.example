# Travu AI - Environment Configuration Example
# Copy this file to .env or configure in your deployment platform (Vercel, Netlify, Cloudflare)

# Optional: Google Gemini API Key for direct server-side or frontend injection
# Get your free Gemini API Key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default AI Model (gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash
